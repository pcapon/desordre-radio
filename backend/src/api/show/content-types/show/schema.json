{
  "kind": "collectionType",
  "collectionName": "shows",
  "info": {
    "singularName": "show",
    "pluralName": "shows",
    "displayName": "Show",
    "description": "A recurring radio program."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "text"
    },
    "host": {
      "type": "string"
    },
    "schedule": {
      "type": "string",
      "description": "Human-readable air time, e.g. \"Jeudi \u00b7 20h\"."
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "azuracastPlaylist": {
      "type": "string",
      "description": "Managed automatically: always equals the title, which is also the AzuraCast playlist name. Matched against now-playing and the schedule."
    },
    "azuracastPlaylistId": {
      "type": "integer",
      "description": "AzuraCast playlist ID. Leave empty to create a playlist named after the title, or paste an existing playlist's ID to link it (it gets renamed to the title)."
    },
    "episodes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::episode.episode",
      "mappedBy": "show"
    }
  }
}
